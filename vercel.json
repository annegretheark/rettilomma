{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "hov.rettilomma.com"
        }
      ],
      "destination": "/hovslager-login.html",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "demo.hovslager.rettilomma.com"
        }
      ],
      "destination": "/demo/index.html",
      "permanent": false
    },
    {
      "source": "/hov",
      "destination": "/hovslager-login.html",
      "permanent": false
    },
    {
      "source": "/demo",
      "destination": "/demo/index.html",
      "permanent": false
    }
  ]
}