{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "hov.rettilomma.com"
        }
      ],
      "destination": "/hovslager-login.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "demo.hovslager.rettilomma.com"
        }
      ],
      "destination": "/public/demo/index.html"
    }
  ]
}
