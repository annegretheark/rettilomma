{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "hov.rettilomma.com" }],
      "destination": "/hovslager-login.html"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "hov.rettilomma.com" }],
      "destination": "/hovslager/:path*"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "demo.hovslager.rettilomma.com" }],
      "destination": "/demo/index.html"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "demo.hovslager.rettilomma.com" }],
      "destination": "/demo/:path*"
    }
  ]
}
