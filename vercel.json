{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "demo.hovslager.rettilomma.com"
        }
      ],
      "destination": "/public/demo/index.html"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "demo.hovslager.rettilomma.com"
        }
      ],
      "destination": "/public/demo/$1"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "hov.rettilomma.com"
        }
      ],
      "destination": "/hovslager-login.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "handverker.rettilomma.com"
        }
      ],
      "destination": "/handverker-login.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "veterinaer.rettilomma.com"
        }
      ],
      "destination": "/behandler-login.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "behandler.rettilomma.com"
        }
      ],
      "destination": "/behandler-login.html"
    },
    {
      "source": "/demo",
      "destination": "/public/demo/index.html"
    },
    {
      "source": "/hov",
      "destination": "/hovslager-login.html"
    },
    {
      "source": "/handverker",
      "destination": "/handverker-login.html"
    },
    {
      "source": "/veterinaer",
      "destination": "/behandler-login.html"
    },
    {
      "source": "/behandler",
      "destination": "/behandler-login.html"
    }
  ]
}