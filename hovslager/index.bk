<!doctype html>
<html lang="nb">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>HovslagerSystem 2.3</title>
  <link rel="stylesheet" href="js/hovslager/hov-clean-style.css?v=20260701-lagre-firma">

<style>
.help-link-login{display:inline-block;margin-top:14px;padding:10px 14px;border-radius:10px;background:#334155;color:#f8fafc;text-decoration:none;font-weight:700}
.help-link-top{display:inline-block;padding:10px 14px;border-radius:10px;background:#334155;color:#f8fafc;text-decoration:none;font-weight:700}
.help-link-login:hover,.help-link-top:hover{filter:brightness(1.08)}
</style>

  <link rel="manifest" href="manifest.webmanifest">
  <meta name="theme-color" content="#0f172a">
</head>
<body>
  <main class="wrap">
    <section id="loginCard" class="card login-card">
      <h1>HovslagerSystem</h1>
      <p class="muted">Logg inn for å se kunder, hester, jobber og firmaoppsett.</p>
      <p><a class="help-link-login" href="brukerveiledning.html" target="_blank" rel="noopener">📖 Brukerveiledning</a></p>
      <label>E-post<input id="loginEmail" type="email" autocomplete="username"></label>
      <label>Passord<input id="loginPassword" type="password" autocomplete="current-password"></label>
      <div class="actions"><button id="loginBtn">Logg inn</button><button id="resetBtn" class="secondary">Glemt passord</button></div>
      <div id="loginMsg"></div>
    </section>

    <section id="appCard" class="hidden">
      <header class="topbar card">
        <div class="brand">
          <img id="headerLogo" class="logo hidden" alt="Logo">
          <div id="headerLogoFallback" class="logo-fallback">HS</div>
          <div><h1 id="headerTitle">HovslagerSystem</h1><p id="headerSub" class="muted"></p></div>
        </div>
        <div class="userline"><span id="userPill" class="pill"></span><a class="help-link-top" href="brukerveiledning.html" target="_blank" rel="noopener">❓ Hjelp</a><button id="refreshBtn" class="secondary">Oppdater</button><button id="logoutBtn" class="danger">Logg ut</button></div>
      </header>

      <nav class="tabs card">
        <button data-tab="dashboard">Oversikt</button>
        <button data-tab="kunder">Kunder</button>
        <button data-tab="hester">Hester</button>
        <button data-tab="jobber">Jobber</button>
        <button data-tab="fakturaer">Faktura</button>
        <button data-tab="firma">Firma</button>
        <button data-tab="priser">Priser</button>
        <button id="adminTabBtn" data-tab="admin" class="hidden">SysAdm</button>
      </nav>

      <section id="dashboard" class="tab card">
        <h2>Oversikt</h2>
        <div id="dashMsg"></div>
        <div class="quick-job card soft-card">
          <h3>Snakk inn ny jobb</h3>
          <p class="muted">Trykk på mikrofonen og si for eksempel: «Skodde Jack, kjørte 18 km». Da settes jobbtype til Fullbeslag, hesten Jack velges hvis den finnes, og kilometer legges inn automatisk. Når du stopper mikrofonen, fylles jobben ut, lagres automatisk og mikrofonen starter på nytt for neste jobb.</p>
          <div class="actions">
            <button id="voiceNewJobbBtn" type="button">🎙 Snakk inn ny jobb</button>
            <button id="voiceStopJobbBtn" type="button" class="secondary">Stopp</button>
            <button id="voiceUseTextJobbBtn" type="button" onclick="window.hovAppUseVoiceTextJobb && window.hovAppUseVoiceTextJobb()" class="secondary">Bruk skrevet tekst</button>
            <button id="newJobbFromDashBtn" type="button" class="secondary">Åpne tom ny jobb</button>
          </div>
          <label class="wide">Tale/tekst fra mikrofon<textarea id="voiceJobbText" placeholder="Talen kommer her. Du kan også skrive og trykke Bruk tekst i ny jobb."></textarea></label>
          <div id="voiceJobbMsg"></div>
        </div>
        <div class="actions"><button id="readLastJobbBtn" type="button" class="secondary" onclick="window.hovAppReadLastJobb && window.hovAppReadLastJobb()">Les inn siste jobb som mal</button></div>
        <p class="muted">«Les inn siste jobb som mal» lager en ny jobb basert på siste registrerte jobb.</p>
        <div id="dashCounts" class="grid"></div>
      </section>

      <section id="kunder" class="tab card hidden">
        <h2>Kunder</h2>
        <h3 id="kundeFormTitle">Ny kunde</h3>
        <p class="muted">Klikk på en rad i listen for å redigere.</p>
        <div class="grid formgrid">
          <label>Navn<input id="kundeNavn"></label><label>Telefon<input id="kundeTelefon"></label>
          <label>E-post<input id="kundeEpost" type="email"></label><label>Kontaktperson<input id="kundeKontakt"></label>
          <label class="wide">Adresse<input id="kundeAdresse"></label>
        </div>
        <div class="actions"><button id="saveKundeBtn">Lagre kunde</button><button id="newKundeBtn" type="button" class="secondary">Ny kunde</button><button id="deleteKundeBtn" type="button" class="danger hidden">Slett kunde</button></div><div id="kundeMsg"></div><div id="kundeList"></div>
      </section>

      <section id="hester" class="tab card hidden">
        <h2>Hester</h2>
        <h3 id="hestFormTitle">Ny hest</h3>
        <p class="muted">Klikk på en rad i listen for å redigere.</p>
        <div class="grid formgrid">
          <label>Kunde<select id="hestKunde"></select></label><label>Navn<input id="hestNavn"></label>
          <label>Rase/type<input id="hestRase"></label><label>Sist skodd<input id="hestSist" type="date"></label>
          <label>Neste besøk<input id="hestNeste" type="date"></label><label>Bilde av hest<input id="hestBildeFile" type="file" accept="image/*"></label><label class="wide">Notater<textarea id="hestNotater"></textarea></label><div id="hestBildePreview" class="image-preview wide"><span class="muted">Ingen bilde valgt.</span></div>
        </div>
        <div class="actions"><button id="saveHestBtn">Lagre hest</button><button id="newHestBtn" type="button" class="secondary">Ny hest</button><button id="deleteHestBtn" type="button" class="danger hidden">Slett hest</button></div><div id="hestMsg"></div><div id="hestList"></div>
      </section>

      <section id="jobber" class="tab card hidden">
        <h2>Jobber</h2>
        <h3 id="jobbFormTitle">Ny jobb</h3>
        <p class="muted">Klikk på en rad i listen for å redigere.</p>
        <div class="grid formgrid">
          <label>Dato<input id="jobbDato" type="date"></label><label>Kunde<select id="jobbKunde"></select></label>
          <label>Hest<select id="jobbHest"></select></label><label>Jobbtype<select id="jobbType"></select></label>
          <label>Km<input id="jobbKm" type="number" step="0.1" placeholder="Blankt hvis ingen km"></label><label>Km-pris<input id="jobbKmPris" type="text" inputmode="decimal" value="5,30"></label>
          <label>Arbeid beløp<input id="jobbArbeid" type="number" step="0.01" value="0"></label><label>Utlegg/varer beløp<input id="jobbVarer" type="number" step="0.01" placeholder="Blankt hvis ingen utlegg"></label>
          <label class="wide">Beskrivelse<textarea id="jobbBeskrivelse"></textarea></label><label>Dato for nye bilder<input id="jobbBildeDato" type="date"></label><label class="wide">Bilder fra jobben<input id="jobbBildeFiles" type="file" accept="image/*" multiple><span class="muted">Du kan laste opp flere bilder. De lagres med datoen over.</span></label><div id="jobbBildePreview" class="image-preview wide"><span class="muted">Ingen bilder valgt.</span></div>
        </div>
        <div class="actions"><button id="saveJobbBtn">Lagre jobb</button><button id="newJobbBtn" type="button" class="secondary">Ny jobb</button><button id="deleteJobbBtn" type="button" class="danger hidden">Slett jobb</button></div><div id="jobbMsg"></div><div id="jobbList"></div>
      </section>

      <section id="fakturaer" class="tab card hidden">
        <h2>Fakturaoversikt</h2>
        <p class="muted">Her ser du både fakturerte og ikke fakturerte jobber. En fakturert jobb kan bare vises som kopi, ikke faktureres på nytt.</p>
        <div class="actions"><button id="loadFakturaBtn" class="secondary">Oppdater fakturaoversikt</button></div>
        <div id="fakturaMsg"></div>
        <div id="fakturaList"></div>
      </section>

      <section id="firma" class="tab card hidden">
        <h2>Firma / Oppsett</h2>
        <div class="grid formgrid">
          <label>Firmanavn<input id="firmaNavn"></label><label>Org.nr / bedriftsnr<input id="firmaOrgnr"></label>
          <label>MVA-nr<input id="firmaMvaNr"></label><label>Telefon<input id="firmaTelefon"></label>
          <label>E-post<input id="firmaEpost" type="email"></label><label>Nettside<input id="firmaNettside"></label>
          <label class="wide">Adresse<input id="firmaAdresse"></label><label>Postnr<input id="firmaPostnr"></label><label>Poststed<input id="firmaPoststed"></label>
          <label>Kontonr<input id="firmaKontonr"></label><label>Vippsnummer<input id="firmaVippsNr"></label>
          <label>Vipps mottaker<input id="firmaVippsMottaker"></label><label>Betalingsfrist dager<input id="firmaBetalingsfrist" type="number"></label>
          <label>Faktura-prefix<input id="firmaFakturaPrefix"></label><label>Neste fakturanr<input id="firmaNesteFakturanr" type="number"></label>
          <label>Standard MVA %<input id="firmaMvaSats" type="number" step="0.01"></label>
        </div>
        <div class="logo-box">
          <h3>Logo</h3>
          <img id="firmaLogoPreview" class="logo-preview hidden" alt="Firmalogo">
          <p id="firmaLogoInfo" class="muted">Ingen logo lagret.</p>
          <input id="firmaLogoFile" type="file" accept="image/png,image/jpeg,image/webp,image/svg+xml">
          <div class="actions"><button id="uploadLogoBtn">Last opp logo</button><button id="deleteLogoBtn" class="danger">Slett logo</button></div>
        </div>

        <div class="logo-box">
          <h3>Backup / Restore</h3>
          <p class="muted">Vanlig hovslager kan ta backup og gjenopprette kun eget firma. Backupen inneholder kunder, hester, jobber, fakturaer, priser, firmaoppsett og bilder.</p>
          <div class="actions">
            <button id="firmaBackupBtn" type="button">Ta backup av eget firma</button>
            <button id="firmaBackupReloadBtn" type="button" class="secondary">Oppdater backup-liste</button>
          </div>
          <div class="grid formgrid">
            <label class="wide">Velg backup for restore<select id="firmaRestoreSelect"></select></label>
          </div>
          <div class="actions">
            <button id="firmaRestoreBtn" type="button" class="danger">Gjenopprett valgt backup</button>
            <button id="firmaRestoreReloadBtn" type="button" class="secondary">Last inn backup-liste</button>
          </div>
          <div id="firmaBackupMsg"></div>
          <h4>Siste backup</h4>
          <div id="firmaBackupList"></div>
        </div>

        <div class="actions"><button id="saveFirmaBtn">Lagre firmaoppsett</button></div><div id="firmaMsg"></div>
      </section>



      <section id="admin" class="tab card hidden">
        <h2>Adminpanel</h2>
        <p class="muted">Kun sysadm. Her kan du velge aktivt firma, opprette firma og administrere brukerprofiler/roller.</p>
        <div id="adminMsg"></div>

        <div class="card soft-card">
          <h3>Aktivt firma</h3>
          <div class="grid formgrid">
            <label class="wide">Velg firma å jobbe med<select id="adminActiveFirma"></select></label>
          </div>
          <div class="actions">
            <button id="adminSwitchFirmaBtn" type="button">Bytt aktivt firma</button>
            <button id="adminReloadBtn" type="button" class="secondary">Oppdater adminliste</button>
          </div>
        </div>

        <div class="card soft-card">
          <h3>Nytt firma</h3>
          <p class="muted">Start med blankt skjema. Logo/bilde er tomt til du velger en fil.</p>
          <div class="grid formgrid">
            <label>Firmanavn<input id="adminFirmaNavn"></label>
            <label>E-post<input id="adminFirmaEpost" type="email"></label>
            <label>Telefon<input id="adminFirmaTelefon"></label>
            <label class="wide">Adresse<input id="adminFirmaAdresse"></label>
            <label class="wide">Logo/bilde<input id="adminFirmaLogoFile" type="file" accept="image/png,image/jpeg,image/webp,image/svg+xml"></label>
            <div id="adminFirmaLogoPreview" class="image-preview wide"><span class="muted">Ingen logo valgt.</span></div>
          </div>
          <div class="actions"><button id="adminCreateFirmaBtn" type="button">Lagre firma</button><button id="adminClearFirmaBtn" type="button" class="secondary">Nytt blankt firma</button></div>
        </div>

        <div class="card soft-card">
          <h3>Brukerprofil / rolle</h3>
          <p class="muted">Brukeren må først finnes i Supabase Auth. Kopier Auth User ID fra Supabase → Authentication → Users.</p>
          <div class="grid formgrid">
            <label class="wide">Auth User ID<input id="adminProfileAuthId" placeholder="uuid fra Supabase Auth"></label>
            <label>E-post<input id="adminProfileEpost" type="email"></label>
            <label>Navn<input id="adminProfileNavn"></label>
            <label>Rolle<select id="adminProfileRole"><option value="hovslager">hovslager</option><option value="sysadm">sysadm</option><option value="deaktivert">deaktivert</option></select></label>
            <label>Firma<select id="adminProfileFirma"></select></label>
          </div>
          <div class="actions"><button id="adminSaveProfileBtn" type="button">Lagre/oppdater profil</button></div>
        </div>



        <div class="card soft-card">
          <h3>SysAdm fakturainnstillinger</h3>
          <p class="muted">Dette gjelder bare fakturaene du som systemadministrator sender til hovslagere for bruk av appen. Hovslagere bruker fortsatt sin egen firmaprofil/logo når de fakturerer sine egne kunder.</p>
          <div class="grid formgrid">
            <label>Logo<input id="appFakturaLogoFile" type="file" accept="image/*"></label>
            <label class="wide">Brevhode / firmanavn<input id="appFakturaBrevhode" placeholder="Rettilomma"></label>
            <label>Org.nr.<input id="appFakturaOrgNr" placeholder="Org.nr."></label>
            <label>Kontonummer<input id="appFakturaKonto" placeholder="0000 00 00000"></label>
            <label>E-post<input id="appFakturaAvsenderEpost" type="email" placeholder="salg@rettilomma.com"></label>
            <label>Telefon<input id="appFakturaAvsenderTelefon" placeholder="Telefon"></label>
            <label class="wide">Adresse<input id="appFakturaAvsenderAdresse" placeholder="Adresse"></label>
            <label class="wide">Standard tekst på faktura<input id="appFakturaStandardTekst" value="Abonnement HovslagerSystem"></label>
            <label class="wide">Bunntekst<textarea id="appFakturaBunntekst" rows="3" placeholder="Takk for handelen"></textarea></label>
          </div>
          <div class="actions">
            <button id="appLagreFakturaDesignBtn" type="button">Lagre fakturainnstillinger</button>
            <button id="appFjernFakturaLogoBtn" type="button" class="secondary">Fjern logo</button>
          </div>
          <div id="appFakturaLogoPreview" class="muted"></div>
          <div id="appFakturaDesignMsg"></div>
        </div>


        <div class="card soft-card">
          <h3>SysAdm: fakturer hovslagere</h3>
          <p class="muted">Her fakturerer greknuts/sysadm hovslagere for abonnement på appen. Dette er adskilt fra vanlig fakturering, der hver hovslager fakturerer sine egne hesteeiere.</p>
          <div class="grid formgrid">
            <label>Hovslager/firma<select id="appFakturaFirma"></select></label>
            <label>Beløp inkl. mva<input id="appFakturaBelop" type="number" step="0.01" value="399"></label>
            <label>Forfallsdager<input id="appFakturaForfallDager" type="number" value="14"></label>
            <label class="wide">Tekst<input id="appFakturaTekst" value="Abonnement HovslagerSystem"></label>
          </div>
          <div class="actions">
            <button id="appLagFakturaBtn" type="button">Lag faktura</button>
            <button id="appDagligFaktureringBtn" type="button" class="secondary">Kjør daglig testfakturering</button>
            <button id="appOppdaterFakturaBtn" type="button" class="secondary">Oppdater liste</button>
          </div>
          <p class="muted">Daglig testfakturering sjekker om appen har vært brukt siste døgn. Ved bruk lages vanlig faktura. Uten bruk lages 0-faktura, kunden deaktiveres og stopp-epost kan sendes.</p>
          <div id="appFakturaMsg"></div>
          <div id="appFakturaList"></div>
        </div>

        <div class="card soft-card admin-backup-card">
          <h3>Backup</h3>
          <p class="muted">Kun sysadm. Backup lagres i privat Supabase bucket <code>hov_backups</code>.</p>
          <div class="grid formgrid">
            <label>Velg firma for firmabackup<select id="adminBackupFirma"></select></label>
          </div>
          <div class="actions">
            <button id="adminBackupFirmaBtn" type="button">Ta backup av valgt firma</button>
            <button id="adminBackupSystemBtn" type="button" class="secondary">Ta full systembackup</button>
            <button id="adminBackupReloadBtn" type="button" class="secondary">Oppdater backup-logg</button>
          </div>
          <div class="grid formgrid">
            <label class="wide">Velg backup for gjenoppretting<select id="adminRestoreSelect"></select></label>
          </div>
          <div class="actions">
            <button id="adminRestoreBackupBtn" type="button" class="danger">Gjenopprett valgt backup</button>
            <button id="adminRestoreReloadBtn" type="button" class="secondary">Last inn restore-liste</button>
          </div>
          <p class="muted">Firmabackup tar bare data og bilder for valgt firma. Systembackup tar hele HovslagerSystem. Restore bruker valgt backupfil fra loggen.</p>
          <div id="adminBackupMsg"></div>
          <h4>Siste backup</h4>
          <div id="adminBackupList"></div>
        </div>

        <h3>Firmaer</h3>
        <div id="adminFirmaList"></div>
        <h3>Brukerprofiler</h3>
        <div id="adminProfileList"></div>
      </section>

      <section id="priser" class="tab card hidden">
        <h2>Prisliste</h2>
        <p class="muted">Importer prislisten fra CSV-filen, eller se eksisterende priser fra databasen.</p>
        <div class="card soft-card">
          <h3 id="prisFormTitle">Ny pris</h3>
          <p class="muted">Klikk på en prislinje i listen for å redigere.</p>
          <div class="grid formgrid">
            <label>Kategori<input id="prisKategori"></label><label>Varenr<input id="prisVarenr"></label>
            <label>Navn<input id="prisNavn"></label><label>Enhet<input id="prisEnhet" value="stk"></label>
            <label>Pris eks. mva<input id="prisEksMva" type="number" step="0.01" value="0"></label><label>MVA %<input id="prisMvaSats" type="number" step="0.01" value="25"></label>
            <label>Pris inkl. mva<input id="prisInklMva" type="number" step="0.01" value="0"></label><label>Aktiv<input id="prisAktiv" type="checkbox" checked></label>
            <label class="wide">Beskrivelse<input id="prisBeskrivelse"></label>
          </div>
          <div class="actions">
            <button id="savePrisBtn" type="button">Lagre pris</button>
            <button id="newPrisBtn" type="button" class="secondary">Ny pris</button>
            <button id="deletePrisBtn" type="button" class="danger hidden">Slett pris</button>
          </div>
          <h3>Importer priser fra CSV</h3>
          <input id="prisCsvFile" type="file" accept=".csv,text/csv">
          <div class="actions">
            <button id="importPrisCsvBtn" type="button">Last inn priser fra CSV</button>
            <button id="reloadPriserBtn" type="button" class="secondary">Oppdater prisliste</button>
          </div>
          <div id="prisImportMsg"></div>
        </div>
        <div id="prisList"></div>
      </section>
    </section>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script src="js/hovslager/config.js?v=keep-existing"></script>
  <script src="js/hovslager/hov-clean-app.js?v=20260701-lagre-firma"></script>
<script>
if ('serviceWorker' in navigator && location.protocol !== 'file:') {
  navigator.serviceWorker.register('sw.js').catch(function(){});
}
</script>
</body>
</html>
